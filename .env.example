# GLM-ZAI-2API — 环境变量配置
# 容器内通过 NF 环境变量设置, 无需本文件

# Z.AI JWT token (从 chat.z.ai → DevTools → Local Storage → "token")
# 不配置则使用 guest 模式 (仅 glm-4.7 可用)
# 配置后可解锁 GLM-5.2 / GLM-5-Turbo 等模型
# ZAI_TOKEN=

# 服务端口
PORT=8080
HOST=0.0.0.0

# 客户端鉴权 token (请求头 Authorization: Bearer ***
# 在 NF 里设置, 对应 ZAI_AUTH_KEY
AUTH_TOKEN=d3vin

# token 池路径 (容器内持久化建议挂载到 /data)
DB_PATH=/data/tokens.sqlite

# 启动时采集 token 数量 (默认 750)
TOKEN_COUNT=750

# 日志级别: debug | info | warn | error
LOG_LEVEL=info